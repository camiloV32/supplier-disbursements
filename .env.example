# API
NODE_ENV=development
PORT=3000

# Database (consumed by docker-compose.yaml and by the API's TypeORM connection)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=supplier_disbursements
DB_LOGGING=false
DB_SYNC=true

# JWT (consumed by the api container via docker-compose env_file)
JWT_SECRET=changeme-use-a-long-random-string
JWT_EXPIRES_IN=8h

# CORS: must match the web app's origin exactly (credentialed requests can't use "*")
CORS_ORIGIN=http://localhost:5173

# Web (baked into the JS bundle at build time by docker-compose's build.args —
# must be reachable from the BROWSER, not the Docker-internal "api" hostname)
VITE_API_URL=http://localhost:3000/v1
